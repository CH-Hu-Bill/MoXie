# ============================================================
# Folia 可选组件配置
# 由 scripts/folia/install.sh 首次复制为 .env
# 修改后执行：docker compose up -d --force-recreate
# ============================================================

# 镜像命名空间和固定版本。不要改成 latest，升级走 update.sh。
FOLIA_IMAGE_NAMESPACE=papersman
FOLIA_STACK_VERSION=1.2.1
FOLIA_SYNC_VERSION=1.0.0

# Web 网关：局域网内可访问
FOLIA_HTTP_BIND=0.0.0.0
FOLIA_HTTP_PORT=18080

# 同步服务默认只监听本机；需要多设备同步时再改成 0.0.0.0
FOLIA_SYNC_BIND=127.0.0.1
FOLIA_SYNC_PORT=13000
FOLIA_SYNC_DATA_DIR=./data/sync
SYNC_TOKEN=change-me-to-a-random-token
DASHBOARD_TOKEN=

# 音乐平台
FOLIA_FORWARD_CLIENT_IP=false
ENABLE_GENERAL_UNBLOCK=false

# QQ 登录态（可选）
QQ_AUTH_SESSION_PATH=
QQ_SESSION_SECRET=

# Navidrome 预置（可选；三项都填才生效）
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
NAVIDROME_PRESET_ALLOW=private
FOLIA_TRUSTED_PROXIES=

# AI 主题（可选；不填则 AI 主题不可用，核心播放正常）
FOLIA_AI_PROVIDER=google
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=
OPENAI_API_TEMPERATURE=0.7
