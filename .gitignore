# ── 敏感配置（含真实密钥/密码，切勿提交；用 inc/config.example.php 作模板）──
inc/config.php

# ── 运行时数据（data/ 下的 JSON、锁文件、上传图片均为运行产生）──
# 保留 .htaccess 安全配置
data/*
!data/.htaccess
!data/uploads/
data/uploads/*
!data/uploads/.htaccess
*.lock

# ── 诊断/临时脚本（调试遗留，不进仓库）──
diag.php
diagnose.php

# ── Composer / PHP 依赖 ──
vendor/
composer.lock

# ── 日志 ──
*.log

# ── 编辑器 / IDE / 操作系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp
*.swo
