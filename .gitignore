# ── 敏感配置（含真实密钥/密码，切勿提交；用 config.example.php 作模板）──
web/inc/config.php

# ── Web 端运行时数据（data/ 下的 JSON、锁文件、上传图片均为运行产生）──
# 保留 .htaccess 安全配置；班级数据子目录 data/classes/ 整体忽略
web/data/*
!web/data/.htaccess
web/data/classes/
web/data/exports/
*.lock

# ── 仓库根目录的数据快照（含真实口令哈希，勿提交）──
/announcements.json
/classes.json
/app_versions.json

# ── 诊断/临时脚本（调试遗留，不进仓库）──
web/diag.php
web/diagnose.php

# ── APK 安装包（后台上传，运行时产物，不进仓库）──
web/apk/

# ── Composer / PHP 依赖 ──
vendor/
composer.lock

# ── 日志 ──
*.log

# ── APP 端（移动开发常见产物）──
app/build/
app/.gradle/
app/local.properties
app/app/release/
app/captures/
app/.cxx/
app/.idea/
app/**/*.iml
app/android/app/release/
app/android/.gradle/
app/android/local.properties
app/ios/Pods/
app/ios/build/
app/.env
app/.env.local

# ── Node / 前端构建（若 APP 端使用）──
node_modules/
dist/
.npm/

# ── 编辑器 / IDE / 操作系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# ── SSH 密钥（生成在项目目录的，绝不能提交）──
id_ed25519
id_ed25519.pub

# ── MCP 第三方服务器 ──
.mcp-server-sftp/

# ── 本机 AI 编码工具 / 临时文件 ──
opencode.json
opencode.json.*
.serena/

# ── Windows 一键脚本下载的运行时（PHP/ffmpeg，体积大，不入库）──
/runtime/

# ── 离线安装包（PHP/ffmpeg 的 zip，用于无网络机器；体积大，不入库）──
/offline/
